{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "dev:all": "concurrently -k -n Laravel,Vite -c blue,green \"php artisan serve --host=127.0.0.1\" \"npm run dev -- --host 127.0.0.1\"",
        "check": "php artisan wayfinder:generate --with-form && tsc --noEmit",
        "types:check": "tsc --noEmit",
        "build:termux": "node scripts/build-termux.mjs"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.1.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^2.1.0",
        "lucide-react": "^0.475.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "sonner": "^2.0.0",
        "tailwind-merge": "^2.6.0",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.2",
        "vite": "^7.3.7"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@types/node": "^22.13.5",
        "autoprefixer": "^10.4.21",
        "babel-plugin-react-compiler": "^1.0.0",
        "concurrently": "^10.0.7",
        "postcss": "^8.5.6",
        "tailwindcss-animate": "^1.0.7"
    }
}